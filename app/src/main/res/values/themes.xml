<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Zyphvert" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowAnimationStyle">@style/Zyphvert.WindowAnimation</item>
    </style>

    <style name="Zyphvert.WindowAnimation" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/zv_slide_in_right</item>
        <item name="android:activityOpenExitAnimation">@anim/zv_slide_out_left</item>
        <item name="android:activityCloseEnterAnimation">@anim/zv_slide_in_left</item>
        <item name="android:activityCloseExitAnimation">@anim/zv_slide_out_right</item>
        <item name="android:taskOpenEnterAnimation">@anim/zv_fade_in</item>
        <item name="android:taskOpenExitAnimation">@anim/zv_fade_out</item>
        <item name="android:taskCloseEnterAnimation">@anim/zv_fade_in</item>
        <item name="android:taskCloseExitAnimation">@anim/zv_fade_out</item>
    </style>
</resources>
